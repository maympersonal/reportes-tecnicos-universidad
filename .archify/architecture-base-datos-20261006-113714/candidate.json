  "cards": [
    {
      "dot": "cyan",
      "title": "Lectura del diagrama",
      "items": [
        "Cada flecha va de la tabla padre a la tabla que contiene la clave foránea.",
        "Las etiquetas indican cardinalidad y política on_delete; NULL identifica una FK opcional."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistencia configurable",
      "items": [
        "Con DATABASE_URL, Django usa PostgreSQL mediante dj_database_url.",
        "Sin DATABASE_URL, usa SQLite en backend/db.sqlite3."
      ]
    },
    {
      "dot": "amber",
      "title": "Decisión de alcance",
      "items": [
        "Se incluyen los diez modelos propios y las entidades User/Group que participan en sus relaciones.",
        "Se omiten tablas internas de Django: permisos, sesiones, content types, admin log y migrations."
      ]
    },
    {
      "dot": "rose",
      "title": "Detalle importante",
      "items": [
        "Reporte.ubicacion es texto libre; no existe una FK desde Reporte hacia el catálogo Ubicacion.",
        "ArchivoReporte guarda la ruta del archivo en la base; los bytes viven bajo MEDIA_ROOT."
      ]
    }
  ]
